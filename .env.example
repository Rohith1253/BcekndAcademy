# ==============================================================================
# Multi-Language Backend Learning Platform - Production Environment Variables
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas / Local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Authentication Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# CORS Allowed Client Origin
FRONTEND_URL=https://your-app.vercel.app
CLIENT_URL=https://your-app.vercel.app

# Pluggable Code Execution Sandbox Provider
# Options: "mock" (default, safe simulation) | "piston" (real sandbox) | "judge0" | "disabled"
CODE_EXECUTION_PROVIDER=mock

# Piston Sandbox Configuration (Optional - when CODE_EXECUTION_PROVIDER=piston)
PISTON_API_URL=https://emkc.org/api/v2/piston

# Judge0 Sandbox Configuration (Optional - when CODE_EXECUTION_PROVIDER=judge0)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_judge0_key_here

# Google Gemini AI Provider (Optional for AI Coding Lab tutor)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Rate Limiting (Optional)
RATE_LIMIT_MAX=500
